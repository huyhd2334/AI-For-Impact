<mxfile host="app.diagrams.net" modified="2026-10-18T00:00:00.000Z" agent="SafeRoute AI" version="24.0.0" type="device"><diagram id="diag_tech_detail" name="Detailed Tech Architecture"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="1. DATA INGESTION &amp; CAMERA INPUT (OpenCV / RTSP)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1480" height="70" as="geometry" /></mxCell><mxCell id="n_rtsp" value="RTSP / Video Stream / File Upload&#10;- H.264 / MP4 / JPEG&#10;- cv2.VideoCapture / cv2.imdecode" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="80" y="50" width="340" height="40" as="geometry" /></mxCell><mxCell id="n_param" value="Context &amp; Parameters&#10;- camera_id: str (Registry)&#10;- timestamp: float | fps: 5.0" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="450" y="50" width="300" height="40" as="geometry" /></mxCell><mxCell id="n_frame" value="Decoded BGR Frame Matrix&#10;[H, W, 3] uint8 (4K/2K/1080p)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="780" y="50" width="300" height="40" as="geometry" /></mxCell><mxCell id="t2" value="2. ROAD SEGMENTATION &amp; 0-MS ROI CACHING (road_manager.py)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="1480" height="120" as="geometry" /></mxCell><mxCell id="n_calib_chk" value="Cache Check&#10;is_calibrated?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="80" y="145" width="110" height="70" as="geometry" /></mxCell><mxCell id="n_twinlite" value="TwinLiteNet Model (Calibration)&#10;- weights/best.pth (1.8MB, CUDA fp32)&#10;- 1st Frame Inference -&gt; [H, W] Mask" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="230" y="150" width="240" height="60" as="geometry" /></mxCell><mxCell id="n_disk_cache" value="Disk Storage Cache&#10;- cache/{cam_id}_road_mask.png&#10;- cache/{cam_id}_road_roi.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=11;fontStyle=0;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="510" y="140" width="200" height="80" as="geometry" /></mxCell><mxCell id="n_ram_cache" value="In-Memory RAM Cache&#10;- dict[camera_id] -&gt; (mask, polys)&#10;- Instant 0ms Reuse for All Frames" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=11;fontStyle=0;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="750" y="140" width="220" height="80" as="geometry" /></mxCell><mxCell id="t3_a" value="3A. FLOOD REASONING ENGINE (flood_reasoner.py)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="470" height="320" as="geometry" /></mxCell><mxCell id="n_masking" value="Road-Corridor Masking&#10;cv2.bitwise_and(Frame, mask=road_mask)&#10;-&gt; Cắt đúng lòng đường, bỏ nhà/cây" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="430" height="45" as="geometry" /></mxCell><mxCell id="n_vlm_gate" value="API Key Gate&#10;GEMINI_API_KEY?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="220" y="360" width="130" height="60" as="geometry" /></mxCell><mxCell id="n_gemini" value="Google Gemini Flash API&#10;- gemini-2.5-flash (Strict JSON Schema)&#10;- Structured output: is_flooded, severity,&#10;safe_for_bikes, confidence, reason" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="200" height="80" as="geometry" /></mxCell><mxCell id="n_cv_reason" value="Local Heuristic CV Reasoner&#10;- HSV Space (s &lt; 55, v &gt; 130)&#10;- Specular Headlights (s &lt; 40, v &gt; 220)&#10;- Laplacian Flatness (|Lap| &lt; 14)&#10;-&gt; road_water_ratio = count(Water)/count(Road)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="290" y="440" width="210" height="80" as="geometry" /></mxCell><mxCell id="n_reason_out" value="Output Reasoning: is_flooded (bool), severity (none/minor/mod/severe), safe_for_bikes (bool), road_water_ratio (float)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="70" y="535" width="430" height="35" as="geometry" /></mxCell><mxCell id="t3_b" value="3B. WATER DEPTH ESTIMATOR (depth_estimator.py)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#E0F7FA;strokeColor=#0097A7;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="540" y="260" width="470" height="320" as="geometry" /></mxCell><mxCell id="n_water_seg" value="Pixel-Level Water Segmentation Mask&#10;- Morphological opening &amp; closing (kernel 9x9)&#10;- Connected components filtering" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E0F7FA;strokeColor=#0097A7;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="430" height="45" as="geometry" /></mxCell><mxCell id="n_sub_check" value="Reference Object Submersion Check&#10;Detected Vehicles &amp; Persons Boxes" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#E0F7FA;strokeColor=#0097A7;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="700" y="360" width="150" height="60" as="geometry" /></mxCell><mxCell id="n_auto_depth" value="Automotive Submersion (Mốc xe)&#10;- Bottom area contact ratio &gt; 25%&#10;- Vành xe: ~12-18cm (conf 0.85)&#10;- Nửa bánh: ~25-35cm (conf 0.88)&#10;- Chạm gầm/pô: ~40-60cm (conf 0.90)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E0F7FA;strokeColor=#0097A7;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="205" height="80" as="geometry" /></mxCell><mxCell id="n_geom_depth" value="Geometric Planar Curve (Diện tích)&#10;- Water ratio &lt; 10%: 4-8cm (xâm xấp)&#10;- Water ratio 10-25%: 10-20cm (vừa)&#10;- Water ratio &gt; 25%: 25-50cm (sâu)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E0F7FA;strokeColor=#0097A7;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="785" y="440" width="205" height="80" as="geometry" /></mxCell><mxCell id="n_depth_out" value="Output Depth: water_depth_cm (float), depth_confidence (0.0-1.0), depth_method (automotive/geometric)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E0F7FA;strokeColor=#0097A7;fontColor=#006064;" vertex="1" parent="1"><mxGeometry x="560" y="535" width="430" height="35" as="geometry" /></mxCell><mxCell id="t3_c" value="3C. VEHICLE TRACKER &amp; CONGESTION (vehicle_counter.py)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1030" y="260" width="500" height="320" as="geometry" /></mxCell><mxCell id="n_yolo" value="YOLOv8 Detection (vn_traffic_surveillance.pt)&#10;- CUDA RTX 3050 | imgsz=1280 | conf=0.18&#10;- Classes: Moto, Car, Bus, Truck, Bicycle&#10;- Strict Overlap NMS (IoU &gt; 0.42, IoS &gt; 0.58)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1050" y="300" width="460" height="55" as="geometry" /></mxCell><mxCell id="n_tracker" value="Centroid &amp; Windowed IoU Tracking&#10;- max_dist = max(80px, bh*1.5, 300*dt)*y_factor&#10;- Window pos_history: buffer window dt &gt;= 0.18s" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1050" y="370" width="460" height="45" as="geometry" /></mxCell><mxCell id="n_speed" value="Perspective Velocity &amp; Smoothing&#10;- m_per_px = px_to_meter / (0.35 + 0.65*norm_y)&#10;- Jitter Gate: disp &lt; 5px or spd &lt; 3.5 -&gt; 0 km/h (stopped)&#10;- EMA Filter: v = 0.55*v_new + 0.45*v_prev" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1050" y="430" width="460" height="50" as="geometry" /></mxCell><mxCell id="n_traffic_out" value="Output Traffic: total_vehicles, stopped_vehicles, slow_vehicles, avg_speed_kmh, flow_vpm, is_jammed (jam if stopped_ratio &gt;= 35%)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1050" y="495" width="460" height="75" as="geometry" /></mxCell><mxCell id="t4" value="4. RESULT FUSION &amp; ENSEMBLE GATE (fusion.py)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="1480" height="160" as="geometry" /></mxCell><mxCell id="n_fusion_engine" value="CameraResultFusion Decision Engine&#10;- Multi-criteria Gate: Fuses Reasoner + Depth Credibility + Traffic State&#10;- Flood Status: flooded (conf &gt;= 0.70) | not_flooded | uncertain&#10;- Severity: none | minor | moderate | severe | safe_for_bikes: bool&#10;- Traffic Status: CLEAR (1) | CROWDED (2) | HEAVY_CONGESTION (3)&#10;- Synthesizes reason description text" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="720" height="115" as="geometry" /></mxCell><mxCell id="n_hud_render" value="Visual Evidence Rendering&#10;- Vector Road Outline (Orange contour)&#10;- Water Overlay (Translucent cyan-blue 35%)&#10;- Vehicle Bounding Boxes + Speed Badges&#10;- Professional Top HUD Dashboard Banner&#10;-&gt; Lưu evidence_captures/obs_{cam_id}_{evt_id}.jpg" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="830" y="630" width="680" height="115" as="geometry" /></mxCell><mxCell id="t5" value="5. FASTAPI REST SERVICE &amp; SE CONTRACT v1 (api.py, schemas.py)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#EDE7F6;strokeColor=#512DA8;fontColor=#311B92;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="1480" height="180" as="geometry" /></mxCell><mxCell id="n_contract" value="CameraObservationEvent (Contract v1 Schema)&#10;- event_id: str (UUID) | camera_id: str&#10;- observed_at: str | source_updated_at: str&#10;- source_revision: int (Monotonic increment)&#10;- flood_status: Enum | severity: Enum | depth_cm: float&#10;- traffic_status: Enum | is_jammed: bool | total_veh: int&#10;- road_mask_cached: bool | evidence_ref: str" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#EDE7F6;strokeColor=#512DA8;fontColor=#311B92;" vertex="1" parent="1"><mxGeometry x="80" y="810" width="440" height="135" as="geometry" /></mxCell><mxCell id="n_api_routes" value="FastAPI Router Endpoints (Uvicorn 8000)&#10;- POST /api/v1/camera/calibrate (/upload)&#10;- POST /api/v1/camera/analyze-frame (/upload)&#10;- POST /api/v1/camera/analyze-video&#10;- GET  /api/v1/camera/{id}/state&#10;- GET  /api/v1/camera/{id}/events (Cursor sync)&#10;- GET  /api/v1/camera/{id}/road-mask (PNG)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=11;fillColor=#EDE7F6;strokeColor=#512DA8;fontColor=#311B92;" vertex="1" parent="1"><mxGeometry x="550" y="810" width="440" height="135" as="geometry" /></mxCell><mxCell id="n_db_tables" value="Database schema: camera_ai&#10;- Table camera_current_state&#10;  (1 row mới nhất / camera)&#10;- Table camera_state_events&#10;  (Append log, .NET Worker đọc cursor)&#10;- Evidence Storage: evidence_captures/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=11;fontStyle=0;fillColor=#EDE7F6;strokeColor=#512DA8;fontColor=#311B92;" vertex="1" parent="1"><mxGeometry x="1020" y="810" width="490" height="135" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_frame" target="n_calib_chk" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Chưa có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_calib_chk" target="n_twinlite" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Lưu đĩa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_twinlite" target="n_disk_cache" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Load RAM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_disk_cache" target="n_ram_cache" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Đã có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_calib_chk" target="n_ram_cache" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_frame" target="n_masking" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Reused Mask (0ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#7B1FA2;strokeWidth=2;" edge="1" source="n_ram_cache" target="n_masking" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Có Key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_vlm_gate" target="n_gemini" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="Offline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_vlm_gate" target="n_cv_reason" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_frame" target="n_water_seg" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#7B1FA2;strokeWidth=2;" edge="1" source="n_ram_cache" target="n_water_seg" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="Có xe ngập" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_sub_check" target="n_auto_depth" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="Không có xe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_sub_check" target="n_geom_depth" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_frame" target="n_yolo" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="BBox vị trí xe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#7B1FA2;strokeWidth=2;" edge="1" source="n_tracker" target="n_sub_check" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_reason_out" target="n_fusion_engine" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_depth_out" target="n_fusion_engine" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_traffic_out" target="n_fusion_engine" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_fusion_engine" target="n_hud_render" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_fusion_engine" target="n_contract" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="evidence_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_hud_render" target="n_contract" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_contract" target="n_api_routes" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="Upsert &amp; Append" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;" edge="1" source="n_contract" target="n_db_tables" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>