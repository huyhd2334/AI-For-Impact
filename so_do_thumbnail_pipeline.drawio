        <mxCell id="e_bad" value="Ảnh quá tối / mờ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d32f2f;strokeWidth=1.5;fontColor=#d32f2f;fontSize=10;" edge="1" source="n_qcheck" target="n_unknown" parent="1">
          <mxGeometry relative="1" as="geometry" />
